#!/usr/bin/env bash
set -euo pipefail

if [ -z "${1:-}" ]; then
  echo "usage: $0 <file.hurl>" >&2
  exit 1
fi

# The seeded users' password: Seed__Password if set, else the API's development settings.
password="${Seed__Password:-$(jq -r '.Seed.Password // empty' ../src/ImperaBook.Api/appsettings.Development.json)}"

hurl --variables-file vars.env --variable "password=$password" --verbose "$1"
